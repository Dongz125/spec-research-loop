# ---- Database ----
# Tạo project miễn phí tại https://neon.tech, copy connection string vào đây
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

# ---- AI provider ----
# Chọn 1 trong 3: anthropic | gemini | ollama
AI_PROVIDER=gemini

# Cần nếu AI_PROVIDER=anthropic. Lấy tại https://console.anthropic.com
ANTHROPIC_API_KEY=

# Cần nếu AI_PROVIDER=gemini (free, không cần thẻ). Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cần nếu AI_PROVIDER=ollama (chạy local, cài tại https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT_MS=120000

# ---- Scholarly sources (OpenAlex) ----
# Key miễn phí; nên cấu hình để tránh hạn mức anonymous/demo.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# ---- Server ----
PORT=4000
FRONTEND_URL=http://localhost:5173

# Chuỗi ngẫu nhiên bí mật, tối thiểu 32 ký tự, dùng để ký access token.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
